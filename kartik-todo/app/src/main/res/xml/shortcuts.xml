<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_add"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/quick_add_shortcut">
        <intent
            android:action="com.kartiklabs.bloom.QUICK_ADD"
            android:targetPackage="com.kynurelabs.bloom"
            android:targetClass="com.kartiklabs.bloom.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="about_privacy"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/about_privacy_shortcut">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kynurelabs.bloom"
            android:targetClass="com.kartiklabs.bloom.AboutPrivacyActivity" />
    </shortcut>
</shortcuts>
